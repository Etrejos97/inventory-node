// Mapeo 1:1 de las entidades JPA del backend original
// (C:\Dev\Pruebas PPI\inventory-fullstack\backend\src\main\java\com\inventory\model).
// Ver docs/CONSTITUTION.md y specs/001-recreate-backend/requirements.md antes de tocar esto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  fullName  String    @map("full_name")
  email     String?
  roleId    Int       @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")

  @@map("users")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  items       Item[]

  @@map("categories")
}

model Status {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  items       Item[]

  @@map("statuses")
}

model Responsible {
  id       Int     @id @default(autoincrement())
  fullName String  @map("full_name")
  position String?
  email    String?
  phone    String?
  isActive Boolean @default(true) @map("is_active")
  items    Item[]

  @@map("responsibles")
}

model Item {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  serialNumber    String?   @unique @map("serial_number")
  categoryId      Int       @map("category_id")
  category        Category  @relation(fields: [categoryId], references: [id])
  statusId        Int       @map("status_id")
  status          Status    @relation(fields: [statusId], references: [id])
  responsibleId   Int?      @map("responsible_id")
  responsible     Responsible? @relation(fields: [responsibleId], references: [id])
  acquisitionDate DateTime? @map("acquisition_date")
  location        String?
  purchaseValue   Decimal?  @map("purchase_value")
  observations    String?
  stock           Int       @default(0)
  minStock        Int       @default(0) @map("min_stock")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  movements       MovementHistory[]

  @@map("items")
}

// Modelo, repo y GET endpoint existen, pero nada escribe acá nunca
// (ver docs/DEUDA.md) — se replica tal cual el original, no se inventa
// un sistema de auditoría real.
model MovementHistory {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id])
  action      String
  fieldName   String?  @map("field_name")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("movement_history")
}
