{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_edits.py\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/trigger_contract_fidelity_review.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Evaluando contract-fidelity-reviewer..."
          }
        ]
      }
    ]
  }
}
